<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:five="http://namespaces.zope.org/five"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    xmlns:browser="http://namespaces.zope.org/browser"
    i18n_domain="mrs5.max">

    <browser:page
      name="avatar"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      class=".avatar.getAvatar"
      permission="base.authenticated"
      />

    <browser:page
        for="Products.CMFPlone.interfaces.IPloneSiteRoot"
        name="max_variables.js"
        class=".variables.MAXJSVariables"
        permission="zope.Public"
        />

    <browser:page
        for="Products.CMFPlone.interfaces.IPloneSiteRoot"
        name="max_variables_chat.js"
        class=".variables.MAXJSVariablesChat"
        permission="zope.Public"
        />

    <!-- Control panel -->
    <browser:page
        name="maxui-settings"
        for="Products.CMFPlone.interfaces.IPloneSiteRoot"
        class=".controlpanel.MAXUISettingsControlPanel"
        permission="cmf.ManagePortal"
        />

    <browser:page
        for="Products.CMFCore.interfaces.ISiteRoot"
        name="getRestrictedToken"
        permission="cmf.ManagePortal"
        class=".tokens.getRestrictedTokenForm"
        />

    <browser:page
        for="Products.CMFCore.interfaces.ISiteRoot"
        name="resetToken"
        permission="base.authenticated"
        class=".tokens.resetMyOauthToken"
        />

    <browser:viewlet
        name="ulearn.oauthngdirective"
        class=".viewlets.OauthNGDirective"
        manager="plone.app.layout.viewlets.interfaces.IPortalHeader"
        permission="zope2.View"
    />

    <browser:page
        for="*"
        name="max.ajaxusersearch"
        class=".views.MAXUserSearch"
        permission="base.authenticated"
    />

    <browser:page
        for="*"
        name="max.hash"
        class=".views.GetMaxHash"
        permission="base.authenticated"
    />

</configure>
